////=======================Optimised Approach=======================///
class Solution {
public:


   bool find(int node, vector<vector<int>> &adj, int m, int v, vector<int> &color)
   {
       if(node==v)
       return 1;
       
       //color to find out m option
       for(int i=0;i<m;i++)
       {
           //check if the adj doesnot have same color
           bool IsPossible=1;
           for(int j=0;j<v;j++)
           {
               if(adj[node][j] && color[j]==i)
               {
                   IsPossible =0;
                   break;
               }
           }
           //we can assign i the color to this node
           if(IsPossible)
           {
               color[node]=i;
               if(find(node+1,adj,m,v,color))
               return 1;
               color[node]=-1;
           }
       }
       return 0;
   }
   
   
   
   
    bool graphColoring(int v, vector<vector<int>> &edges, int m)
    {
        // Convert edges into adjacency matrix
        vector<vector<int>> adj(v, vector<int>(v, 0));

        for (auto &edge : edges)
        {
            int u = edge[0];
            int w = edge[1];

            adj[u][w] = 1;
            adj[w][u] = 1;
        }

        vector<int> color(v, -1);
        
        return find(0,adj,m,v,color);

        //return DFS(0, color, adj, m, v);
    }
};








