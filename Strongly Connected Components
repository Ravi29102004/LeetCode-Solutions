class Solution {
  public:
  
  
  void DFS(int node, vector<vector<int>> &adj,vector<int> &disc, vector<int> &low, vector<bool> &visited, stack<int> &st, vector<bool> &InStack, vector<vector<int>> &ans, int &timer)
  {
      visited[node]=1;
      disc[node]=low[node]=timer;
      
      st.push(node);
      InStack[node]=1;
      
      for(int j=0;j<adj[node].size();j++)
      {
          int neigh=adj[node][j];
          if(!visited[neigh])
          {
              timer++;
              DFS(neigh,adj,disc,low,visited,st,InStack,ans,timer);
              low[node]=min(low[node],low[neigh]);
          }
          else
          {
              //if it is INstack present in the node
              if(InStack[neigh])
              low[node]=min(low[node],disc[neigh]);
          }
          
      }
      if(disc[node]==low[node])
      {
          vector<int>temp;
          while(!st.empty() && st.top()!=node)
          {
              temp.push_back(st.top());
              InStack[st.top()]=0;
              st.pop();
          }
          
          temp.push_back(node);
          InStack[node]=0;
          st.pop();
          sort(temp.begin(),temp.end());
           
          ans.push_back(temp);
          
          
      }
  }
  
  
  
    vector<vector<int>> findSCC(vector<vector<int>>& adj) {
        // code here
        
        int V=adj.size();
        vector<vector<int>>ans;
        vector<int>disc(V);
        vector<int>low(V);
        vector<bool>visited(V,0);
        
        stack<int>st;
        vector<bool>InStack(V,0);
        int timer=0;
        
        
        //agar incase node visited naa ho to
        for(int i=0;i<V;i++)
        {
            if(!visited[i])
            // DFS(i,adj,visited,disc,low,st,InStack,ans,timer);
            DFS(i, adj, disc, low, visited, st,
                InStack, ans, timer);
        }
        
        sort(ans.begin(),ans.end());
        
        return ans;
    }
};
