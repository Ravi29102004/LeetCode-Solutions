//Merge Sort +divide-conquer method using and dividing by rows method

class Solution {
  public:

  vector<int> merge(vector<int>&mat1, vector<int>&mat2)
  {
      vector<int>temp;

      int left=0, right=0;

      while(left<mat1.size() && right<mat2.size())
      {
          if(mat1[left]<=mat2[right])
          {
              temp.push_back(mat1[left]);
              left++;
          }
          else
          {
              temp.push_back(mat2[right]);
              right++;
          }
      }

      while(left<mat1.size())
      {
          temp.push_back(mat1[left]);
          left++;
      }

      while(right<mat2.size())
      {
          temp.push_back(mat2[right]);
          right++;
      }

      return temp;
  }


  vector<int> mergesort(vector<vector<int>> &mat, int start, int end)
  {
      if(start==end)
          return mat[start];

      // yahan total elements nahi,
      // rows/arrays divide ho rahi hain
      int mid=start+(end-start)/2;

      vector<int>left =
          mergesort(mat,start,mid);

      vector<int>right =
          mergesort(mat,mid+1,end);

      return merge(left,right);
  }


  vector<int> mergeArrays(vector<vector<int>> &mat)
  {
      if(mat.empty())
          return {};

      return mergesort(mat,0,mat.size()-1);
  }
};





